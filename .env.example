# Copy this file to .env and override any values you want to change.
# .env is gitignored; .env.example is committed as the canonical reference.

# ─── PostgreSQL (required) ──────────────────────────────────────────────
# Consumed by the postgres image entrypoint on first init.
POSTGRES_USER=dhis
POSTGRES_PASSWORD=dhis
POSTGRES_DB=dhis
TZ=Europe/Oslo

# ─── pgAdmin (required — pgadmin4 image entrypoint reads these) ─────────
# Desktop mode (PGADMIN_CONFIG_SERVER_MODE=False) is set in compose.pgadmin.yml,
# so these become the master-identity values inside pgadmin's internal DB and
# are otherwise invisible in day-to-day use.
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# ─── DHIS2 (optional — all have defaults) ───────────────────────────────
# initdb.sh defaults DHIS2_USER to 'admin' and DHIS2_PASSWORD to 'district'.
# The password is bcrypt-hashed at init time and applied to every row in the
# userinfo table, so every existing DHIS2 user ends up with this same password.
# Uncomment to override:
# DHIS2_USER=admin
# DHIS2_PASSWORD=district
